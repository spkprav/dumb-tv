<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jellyfin address is entered on the TV and is usually a LAN IP over HTTP.
  Domain rules cannot match raw IP addresses, so cleartext is allowed for this app.
  Wallpaper downloads still use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
